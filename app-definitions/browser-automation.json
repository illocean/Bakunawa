[
  {
    "name": "Playwright",
    "process": [
      "node",
      "chrome",
      "firefox",
      "headless_shell"
    ],
    "category": "Browser Automation Caches",
    "locations": [
      {
        "env": "LOCALAPPDATA",
        "path": "ms-playwright/chromium-*"
      },
      {
        "env": "LOCALAPPDATA",
        "path": "ms-playwright/chromium_headless_shell-*"
      },
      {
        "env": "USERPROFILE",
        "path": ".cache/ms-playwright/chromium-*"
      },
      {
        "env": "USERPROFILE",
        "path": ".cache/ms-playwright/chromium_headless_shell-*"
      }
    ]
  },
  {
    "name": "Puppeteer",
    "process": [
      "node",
      "chrome",
      "headless_shell"
    ],
    "category": "Browser Automation Caches",
    "locations": [
      {
        "env": "USERPROFILE",
        "path": ".cache/puppeteer"
      }
    ]
  },
  {
    "name": "Selenium",
    "process": [
      "selenium",
      "chromedriver",
      "geckodriver",
      "msedgedriver"
    ],
    "category": "Browser Automation Caches",
    "locations": [
      {
        "env": "USERPROFILE",
        "path": ".cache/selenium"
      }
    ]
  }
]
